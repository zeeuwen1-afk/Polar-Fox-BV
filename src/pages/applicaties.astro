---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PackageGrid from '../components/PackageGrid.astro';
import AppExplorer from '../islands/AppExplorer';
import { lowestMonthly, lowestStart, packages } from '../content/packages';
import { formatEuro } from '../lib/pricing';
import { serviceJsonLd } from '../lib/jsonld';

const fromMonthly = formatEuro(lowestMonthly('apps'));
const fromStart = formatEuro(lowestStart('apps'));
const beheerApp = packages.beheer.items.find((item) => item.id === 'beheer-app');
const checkFee = formatEuro(packages.beheer.checkFee);

const securityTiles = [
  { title: 'Inloggen met 2FA', text: 'Tweestapsverificatie standaard, ook voor je eigen team.' },
  { title: 'Eigen database', text: 'Jouw data in een eigen database, niet gedeeld met anderen.' },
  {
    title: 'Data in de EU',
    text: 'Hosting en opslag in Europese datacenters, met dagelijkse back-ups.',
  },
  {
    title: 'Verwerkersovereenkomst',
    text: 'Standaard bij elk pakket, zodat je AVG-plichten geregeld zijn.',
  },
];

const integrations = [
  'Kassasystemen',
  'Mollie en Stripe',
  'E-mail en nieuwsbrieven',
  'Microsoft 365',
  'Boekhoudpakketten',
  'AI op Europese servers',
];
---

<BaseLayout
  jsonLd={[serviceJsonLd(packages.apps, '/applicaties')]}
  title="Applicaties"
  description={`Maatwerk applicaties vanaf ${fromMonthly} per maand excl. btw: klantportalen, boekingssystemen, dashboards en ledenomgevingen. Gebouwd, gehost en beheerd door één partner.`}
>
  <PageHero
    sticker="Applicaties"
    stickerColor="lime"
    subline="Geen standaardpakket waar jij je aan aanpast, maar software rond jouw manier van werken. Met alles erop en eraan: hosting, beveiliging, updates en doorontwikkeling."
  >
    Software die werkt zoals <span class="mark-pink">jij</span> werkt.
    <div slot="aside" class="card-lg on-ink bg-ink p-6 text-paper shadow-hard-lg-lime md:p-8">
      <p class="text-sm font-bold uppercase tracking-wide text-lime">Applicaties</p>
      <p class="mt-2 text-3xl font-bold tracking-tight">vanaf {fromMonthly} per maand</p>
      <p class="mt-1">startbijdrage vanaf {fromStart}, excl. btw</p>
      <a href="/intake?soort=app" class="btn btn-lime mt-6 w-full">
        Bespreek je idee
      </a>
    </div>
  </PageHero>

  <section class="container-site py-12 md:py-16" aria-labelledby="verkenner">
    <h2 id="verkenner">
      Wat voor app <span class="mark-lime">heb je nodig?</span>
    </h2>
    <div class="mt-10">
      <AppExplorer client:visible />
    </div>
  </section>

  <section class="container-site py-8" aria-labelledby="overname">
    <div class="card-lg bg-pink p-6 md:p-10">
      <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-center">
        <div>
          <h2 id="overname">
            Je app uit Lovable of Bolt <span class="mark-lime">loopt vast?</span>
          </h2>
          <p class="mt-4 max-w-2xl text-xl">
            Snel gebouwd, maar nu onbetrouwbaar, onveilig of niet meer uit te breiden? We nemen hem
            over, maken hem stabiel en beheren hem daarna voor een vast bedrag.
          </p>
        </div>
        <div class="flex flex-col gap-4">
          <div class="card bg-paper p-5">
            <p class="text-sm font-bold uppercase tracking-wide">Overname-check</p>
            <p class="text-3xl font-bold tracking-tight">
              {checkFee} <span class="text-base">excl. btw</span>
            </p>
            <p class="mt-1 text-sm">Beoordeling van code, beveiliging en hosting, met advies.</p>
          </div>
          <div class="card bg-paper p-5">
            <p class="text-sm font-bold uppercase tracking-wide">Beheer Applicatie</p>
            <p class="text-3xl font-bold tracking-tight">
              vanaf {formatEuro(beheerApp?.monthly ?? 0)}{' '}
              <span class="text-base">p/m excl. btw</span>
            </p>
            <p class="mt-1 text-sm">Database, hosting, incidenten en 1 uur per maand.</p>
          </div>
          <a href="/intake?soort=beheer" class="btn btn-ink">
            Laat je app beoordelen
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-site py-12 md:py-16" aria-labelledby="veilig">
    <h2 id="veilig">
      Veilig vanaf de <span class="mark-sky">eerste regel.</span>
    </h2>
    <ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      {securityTiles.map((tile) => (
        <li class="card flex flex-col gap-2 p-5">
          <span
            class="inline-block h-4 w-4 rounded-full border-[3px] border-ink bg-lime"
            aria-hidden="true"
          />
          <h3 class="text-xl">{tile.title}</h3>
          <p>{tile.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-8 rounded-[18px] border-[3px] border-ink bg-stone p-5 md:p-6">
      <p class="font-bold">Koppelingen die we kennen</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {integrations.map((name) => (
          <li class="rounded-full border-[3px] border-ink bg-paper px-3 py-1 text-sm font-bold">
            {name}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-site py-12 md:py-16" aria-labelledby="pakketten">
    <h2 id="pakketten" class="sr-only">
      Pakketten voor applicaties
    </h2>
    <PackageGrid group={packages.apps} />
  </section>
</BaseLayout>
