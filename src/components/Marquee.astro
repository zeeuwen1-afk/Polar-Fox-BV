---
import { marqueeItems } from '../content/site';

/**
 * Lopende band: zwarte band, licht gedraaid, lime tekst met roze sterren.
 * Puur decoratief (aria-hidden); dezelfde woorden staan elders als tekst.
 * De inhoud staat er twee keer in zodat de animatie naadloos doorloopt.
 * Bij prefers-reduced-motion staat de band stil.
 */
---

<!-- Buitenste div knipt de uitstekende hoeken van de gedraaide band af, anders ontstaat horizontale scroll. -->
<div class="my-12 overflow-x-clip py-3" aria-hidden="true">
  <div class="marquee -rotate-[1.2deg] overflow-hidden border-y-[3px] border-ink bg-ink py-4">
    <div class="marquee-track flex w-max">
      {[0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {marqueeItems.map((item) => (
            <li class="flex items-center">
              <span class="px-5 text-[26px] font-bold tracking-tight whitespace-nowrap text-lime md:text-[34px]">
                {item}
              </span>
              <span class="text-[26px] text-pink md:text-[34px]">✦</span>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee 30s linear infinite;
    }
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      /* Twee identieke lijsten: na de helft staat alles weer op zijn plek. */
      transform: translateX(-50%);
    }
  }
</style>
