---
/**
 * Duidelijk gelabelde placeholder-illustratie, geen stockfoto. Wordt gebruikt
 * tot de echte schermafbeeldingen en foto's in public/images/ staan.
 * Voor een "voorbeeldscherm" geef je drie demo-regels mee.
 */
interface Props {
  label: string;
  lines?: readonly string[];
  tone?: 'stone' | 'paper' | 'sun';
  aspect?: 'video' | 'photo';
  class?: string;
}

const { label, lines = [], tone = 'stone', aspect = 'video', class: className = '' } = Astro.props;
const toneClass = { stone: 'bg-stone', paper: 'bg-paper', sun: 'bg-sun' }[tone];
const aspectClass = aspect === 'photo' ? 'aspect-[4/3]' : 'aspect-[16/10]';
---

<figure
  class:list={[
    'm-0 flex flex-col overflow-hidden rounded-[18px] border-[3px] border-ink shadow-hard',
    toneClass,
    aspectClass,
    className,
  ]}
  role="img"
  aria-label={`Placeholder: ${label}`}
>
  <div
    class="flex items-center gap-2 border-b-[3px] border-ink bg-paper px-3 py-2"
    aria-hidden="true"
  >
    <span class="h-3 w-3 rounded-full border-[2px] border-ink bg-pink"></span>
    <span class="h-3 w-3 rounded-full border-[2px] border-ink bg-sun"></span>
    <span class="h-3 w-3 rounded-full border-[2px] border-ink bg-lime"></span>
    <span class="ml-2 text-xs font-bold uppercase tracking-wide">{label}</span>
  </div>
  <div class="flex flex-1 flex-col justify-center gap-3 p-5" aria-hidden="true">
    {lines.length > 0 ? (
      lines.map((line) => (
        <div class="flex items-center gap-3 rounded-[10px] border-[3px] border-ink bg-paper px-3 py-2 text-sm font-bold">
          <span class="h-2.5 w-2.5 shrink-0 rounded-full bg-lime" />
          {line}
        </div>
      ))
    ) : (
      <div class="flex flex-1 items-center justify-center rounded-[10px] border-[3px] border-dashed border-ink text-center text-sm font-bold">
        Beeld volgt
      </div>
    )}
  </div>
</figure>
