---
import '@fontsource-variable/space-grotesk';
// Het latin-bestand is het enige dat Nederlandse tekst nodig heeft; we preloaden het.
import fontUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../content/site';
import { organizationJsonLd } from '../lib/jsonld';

/**
 * Basislayout voor elke pagina: metadata, skiplink, header, main en footer.
 * `title` is de paginatitel zonder suffix; de suffix " | Polar Fox" komt hier.
 */
interface Props {
  title: string;
  description: string;
  /** Volledige titel gebruiken zonder suffix (bijvoorbeeld op de homepage). */
  titleIsFull?: boolean;
  /** Pad van de OG-afbeelding; standaard de huisstijlafbeelding. */
  ogImage?: string;
  /** Zoekmachines weren (bijvoorbeeld /dev en /inloggen). */
  noindex?: boolean;
  /** JSON-LD-objecten die in de <head> komen. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  titleIsFull = false,
  ogImage = '/og-image.png',
  noindex = false,
  jsonLd = [],
} = Astro.props;

const fullTitle = titleIsFull ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url);
const ogImageUrl = new URL(ogImage, site.url);
const allJsonLd = [organizationJsonLd(), ...jsonLd];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Polar Fox: Maatwerk software. Vast bedrag." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#111111" />

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />

    {allJsonLd.map((data) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
    ))}
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skiplink">
      Direct naar de inhoud
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
