# Kopieer naar .env (site) of worker/.dev.vars (Worker). Nooit committen.
# In productie: `wrangler secret put <NAAM>` (zie docs/RUNBOOK.md).

# --- Site (Astro, build-time; PUBLIC_ prefix = zichtbaar in de browser) ---
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Volledige URL van de intake-API. Leeg laten = zelfde origin (/api/intake).
PUBLIC_INTAKE_API_URL=

# --- Worker (worker/.dev.vars lokaal, wrangler secret in productie) ---
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
BREVO_API_KEY=xkeysib-...
INTAKE_TO_EMAIL=info@polarfoxbv.nl
INTAKE_FROM_EMAIL=info@polarfoxbv.nl
ALLOWED_ORIGINS=https://polarfoxbv.nl,https://www.polarfoxbv.nl
# Dagelijkse salt voor het hashen van IP-adressen in logs (willekeurige string).
LOG_SALT=verander-mij
